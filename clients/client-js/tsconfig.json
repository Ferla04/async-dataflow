{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "*": ["types/*"] },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "es2020",
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}
