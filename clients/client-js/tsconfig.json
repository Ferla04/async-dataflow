{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "*": ["types/*"] },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2020",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node"]
  },
 "ts-node": {
    "esm": true,
    "transpileOnly": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
